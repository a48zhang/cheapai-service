{
  "name": "sub2api-cloudflare",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev:web": "node scripts/start-react-dev.mjs",
    "dev:worker": "pnpm --filter ./apps/worker run dev",
    "build:cloud": "pnpm -r --filter \"@cheapai/*\" --filter @sub2api/worker --filter @sub2api/apicompat run build",
    "typecheck:cloud": "pnpm -r --filter \"@cheapai/*\" --filter @sub2api/worker --filter @sub2api/apicompat run typecheck",
    "build": "pnpm run build:cloud",
    "typecheck": "pnpm run typecheck:cloud",
    "build:desktop": "pnpm -r --filter @sub2api/desktop --filter @sub2api/desktop-runtime --filter @sub2api/desktop-contracts run build",
    "dev:desktop": "node scripts/desktop/dev-desktop.mjs dev",
    "package:desktop": "node scripts/desktop/dev-desktop.mjs package",
    "typecheck:desktop": "pnpm -r --filter @sub2api/desktop --filter @sub2api/desktop-runtime --filter @sub2api/desktop-contracts run typecheck",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:workers": "vitest run --project workers",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "lint:web": "pnpm --filter @cheapai/web exec eslint src",
    "test:e2e": "playwright test",
    "production:check": "pnpm --filter @cheapai/web run build && pnpm --filter @sub2api/worker exec wrangler deploy --env production --dry-run --strict --outdir ../../.wrangler/build-production",
    "lint:shared": "pnpm --filter @cheapai/web exec eslint ../../packages/api-client/src ../../packages/contracts/src ../../packages/theme/src",
    "format:web": "prettier --write \"apps/web/src/**/*.{ts,tsx,css}\" \"packages/api-client/src/**/*.ts\" \"packages/contracts/src/**/*.ts\" apps/web/eslint.config.js eslint.config.mjs \"packages/theme/**/*.{ts,tsx,js,mjs,mts,css,json}\"",
    "format:check:web": "prettier --check \"apps/web/src/**/*.{ts,tsx,css}\" \"packages/api-client/src/**/*.ts\" \"packages/contracts/src/**/*.ts\" apps/web/eslint.config.js eslint.config.mjs \"packages/theme/**/*.{ts,tsx,js,mjs,mts,css,json}\"",
    "test:desktop-ui": "playwright test --config playwright.desktop.config.ts"
  },
  "devDependencies": {
    "@cheapai/api-client": "workspace:*",
    "@cheapai/contracts": "workspace:*",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@playwright/test": "1.63.0",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
