{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cheapai.dev",
  "version": "0.0.0",
  "identifier": "dev.cheapai.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @sub2api/desktop dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter @sub2api/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "cheapai.dev",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/generated/32x32.png",
      "icons/generated/128x128.png",
      "icons/generated/128x128@2x.png",
      "icons/generated/icon.icns",
      "icons/generated/icon.ico"
    ],
    "resources": ["resources/generated/runtime/**/*"]
  }
}
