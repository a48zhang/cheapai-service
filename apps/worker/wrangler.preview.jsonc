{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Fixed shared staging environment. PR CI only connects to these resources.
  "name": "cheapai-preview",
  "account_id": "4ac5221079fd3481ce2d92f1d1e049cd",
  "main": "index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true, "persist": true, "head_sampling_rate": 1 }
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "PUBLIC_BASE_URL": "https://cheapai-preview.alphazhang689.workers.dev",
    "EMAIL_VERIFICATION_READY": "false"
  },
  "triggers": { "crons": [] },
  "send_email": [],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/v1", "/v1/*", "/healthz"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cheapai-preview",
    "database_id": "f9719b76-adb4-4ebe-be98-6e784e2440a1",
    "migrations_dir": "../../migrations"
  }],
  "kv_namespaces": [{
    "binding": "CACHE",
    "id": "2e433b90bb3a4bc4a1b890852384bc80"
  }],
  "durable_objects": {
    "bindings": [{ "name": "GATE", "class_name": "Gate" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Gate"] }]
}
