{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Top-level is local only. Builds/deploys must explicitly select --env production.
  // Local bindings use placeholders; native Preview overrides are inherited by production.
  "name": "sub2api-cloudflare-local",
  "main": "index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "ENVIRONMENT": "local" },
  // Five-minute maintenance schedule. This file alone does not deploy a trigger.
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/v1", "/v1/*", "/healthz"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "sub2api-cloudflare-local",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "../../migrations",
    "remote": false
  }],
  "kv_namespaces": [{
    "binding": "CACHE",
    "id": "00000000000000000000000000000001",
    "remote": false
  }],
  "durable_objects": {
    "bindings": [{ "name": "GATE", "class_name": "Gate" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Gate"] }],
  // Email Service uses send_email / SendEmail. Local simulation never delivers mail.
  "send_email": [{
    "name": "EMAIL",
    "allowed_sender_addresses": ["local@example.invalid"],
    "allowed_destination_addresses": ["local-recipient@example.invalid"],
    "remote": false
  }],
  "previews": {
    "kv_namespaces": [{
      "binding": "CACHE",
      "id": "2e433b90bb3a4bc4a1b890852384bc80"
    }],
    "d1_databases": [{
      "binding": "DB",
      "database_id": "f9719b76-adb4-4ebe-be98-6e784e2440a1"
    }],
    // Native Previews allocate their own Gate namespace and storage.
    "durable_objects": {
      "bindings": [{ "name": "GATE", "class_name": "Gate" }]
    },
    "observability": {
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": false,
        "head_sampling_rate": 1,
        "persist": true
      },
      "issues": {
        "enabled": false
      }
    }
  },
  "env": {
    // Match the production Worker settings maintained in the Cloudflare Dashboard.
    "production": {
      "name": "sub2api-cloudflare-production",
      "upload_source_maps": true,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": { "enabled": true, "invocation_logs": true, "persist": true, "head_sampling_rate": 1 }
      },
      "account_id": "4ac5221079fd3481ce2d92f1d1e049cd",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [
        { "pattern": "pre.cheapai.dev/*", "zone_name": "cheapai.dev" },
        { "pattern": "cheapai.dev/*", "zone_name": "cheapai.dev" },
        { "pattern": "www.cheapai.dev/*", "zone_name": "cheapai.dev" }
      ],
      // Apply origin selection and security headers before serving static assets.
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_BASE_URL": "https://cheapai.dev",
        "EMAIL_PROVIDER": "resend",
        "EMAIL_FROM": "noreply@mail.cheapai.dev",
        // RESEND_API_KEY and EMAIL_HMAC_KEY belong in Worker Secrets, never vars.
        "EMAIL_VERIFICATION_READY": "true"
      },
      "triggers": { "crons": ["*/5 * * * *"] },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "sub2api-cloudflare-production",
        "database_id": "d85930ad-8e4f-41b7-9fb6-ddf97719e41d",
        "migrations_dir": "../../migrations",
        "remote": false
      }],
      "kv_namespaces": [{
        "binding": "CACHE",
        "id": "3da22af80f0946cdbb9cd85caee9810d",
        "remote": false
      }],
      "durable_objects": {
        "bindings": [{ "name": "GATE", "class_name": "Gate" }]
      },
      "send_email": []
    }
  }
}
