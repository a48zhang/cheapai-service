# Copy to .env.local and point these paths at a locally trusted certificate
# whose subject alternative names cover 127.0.0.1.
CHEAPAI_WEB_TLS_KEY_FILE=/absolute/path/to/127.0.0.1-key.pem
CHEAPAI_WEB_TLS_CERT_FILE=/absolute/path/to/127.0.0.1-cert.pem

# Optional local ports. The React app is HTTPS; Wrangler is loopback-only HTTP.
CHEAPAI_WEB_PORT=5173
CHEAPAI_WORKER_PORT=8787
